.DS_Store
__pycache__/
chlu/workspaces/
shell_scripts/
.venv/
.coverage
coverage.xml
.pytest_cache/
*.egg-info/
dist/
build/

# Slurm job logs (CSF3): ignore the .out files, keep the dir (Slurm needs it to
# exist at submit time; .gitkeep makes it survive a fresh clone).
logs/*
!logs/.gitkeep

# Ignore individual projects but keep the structure
projects/*/
!projects/README.md
!projects/.gitkeep
.claude/**
docs/**

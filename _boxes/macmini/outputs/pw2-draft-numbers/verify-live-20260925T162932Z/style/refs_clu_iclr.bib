	file = {Preprint PDF:/Users/user/Zotero/storage/ZR9IFYAR/Valevski et al. - 2025 - Diffusion Models Are Real-Time Game Engines.pdf:application/pdf;Snapshot:/Users/user/Zotero/storage/SHJPU44H/2408.html:text/html},

\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Each arm succeeding and failing, Table~\ref {tab:t7}, seed 0, $\ensuremath  {K^{\star }}=32$.} For each arm (bracket and coloured frame at left) one held-out request on which that arm renders validly and one on which it does not, each drawn uniformly with a fixed seed among the qualifying requests. Every arm, and the lookup floor, is rendered on every request through one frozen decoder, asserted identical across panels; the mark is the external judge's verdict. The store's own failure is shown in its second row.}}{8}{figure.3}\protected@file@percent }
\newlabel{fig:t7-per-arm}{{3}{8}{\textbf {Each arm succeeding and failing, Table~\ref {tab:t7}, seed 0, $\Kstar =32$.} For each arm (bracket and coloured frame at left) one held-out request on which that arm renders validly and one on which it does not, each drawn uniformly with a fixed seed among the qualifying requests. Every arm, and the lookup floor, is rendered on every request through one frozen decoder, asserted identical across panels; the mark is the external judge's verdict. The store's own failure is shown in its second row}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Requests on which a rival succeeds and the store fails exist on every seed (Table~\ref {tab:t7}).} Counted over all 5,688 held-out requests per seed, a learned rival renders validly where the store does not on 30 / 24 / 30 requests at seeds 0 / 1 / 2 (MLP 26 / 11 / 3, LSTM 13 / 13 / 25, transformer 2 / 3 / 6, continuous MLP 0 / 1 / 0; the store is valid on 5,177 / 5,167 / 5,354); the lookup floor, which is not a rival, does so on 67 / 26 / 46. One such request per rival is shown at seed 0 (MLP, LSTM, transformer); the store's panel carries the blue frame and a failing mark on every row.}}{9}{figure.4}\protected@file@percent }
\newlabel{fig:t7-rival-wins}{{4}{9}{\textbf {Requests on which a rival succeeds and the store fails exist on every seed (Table~\ref {tab:t7}).} Counted over all 5,688 held-out requests per seed, a learned rival renders validly where the store does not on 30 / 24 / 30 requests at seeds 0 / 1 / 2 (MLP 26 / 11 / 3, LSTM 13 / 13 / 25, transformer 2 / 3 / 6, continuous MLP 0 / 1 / 0; the store is valid on 5,177 / 5,167 / 5,354); the lookup floor, which is not a rival, does so on 67 / 26 / 46. One such request per rival is shown at seed 0 (MLP, LSTM, transformer); the store's panel carries the blue frame and a failing mark on every row}{figure.4}{}}

\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces \textbf  {Exact (store-scoped) deletion on the single design, $\ensuremath  {K^{\star }}=32$, TEST, fit pool 131,072 rows, seeds 0, 1 and 2, one row per seed ($n=1$ each): four measurements per scope.} Forgetting $c$ is: downdate the store, downdate the address book's statistics, punch the hole. \textbf  {(a) A result}: the store equals the store refit without the rows (``exactness'', the store's maximum absolute mode deviation against it). \textbf  {(b) A result}: the address book's statistics equal those refit without the rows; the address-book downdate is new, and every (b) cell is a named placeholder. \textbf  {(c) A display, never a result}: requests for $c$ refused through the hole, a flag in the coupling table; symbolic refusal is not claimed. \textbf  {(d) A result}: survivor $\Delta $, the paired composition change on corners that do not request the deleted scope, measured with the address book carried across the basis change, not downdated. Seeds 1 and 2 are the lower block, one row per seed ($n=1$ each), so every scope prints three seeds; they re-read the single design's scored artefacts and spend no new scored run.}}{13}{table.4}\protected@file@percent }
\newlabel{tab:del}{{4}{13}{\textbf {Exact (store-scoped) deletion on the single design, $\Kstar =32$, TEST, fit pool 131,072 rows, seeds 0, 1 and 2, one row per seed ($n=1$ each): four measurements per scope.} Forgetting $c$ is: downdate the store, downdate the address book's statistics, punch the hole. \textbf {(a) A result}: the store equals the store refit without the rows (``exactness'', the store's maximum absolute mode deviation against it). \textbf {(b) A result}: the address book's statistics equal those refit without the rows; the address-book downdate is new, and every (b) cell is a named placeholder. \textbf {(c) A display, never a result}: requests for $c$ refused through the hole, a flag in the coupling table; symbolic refusal is not claimed. \textbf {(d) A result}: survivor $\Delta $, the paired composition change on corners that do not request the deleted scope, measured with the address book carried across the basis change, not downdated. Seeds 1 and 2 are the lower block, one row per seed ($n=1$ each), so every scope prints three seeds; they re-read the single design's scored artefacts and spend no new scored run}{table.4}{}}

\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces \textbf  {CMAZE-T, one row per input condition, unseen $n$-way; (a)~3 seeds per row, (b), (c)~six seeds and two configurations.} (a)~Validity under the exact judge at each seed for the store (circles) and for the condition's best matched rival, the matched rival with the highest three-seed mean over every family and both training budgets; a tick marks each three-seed mean. One rule labels every row from its artefact: \textsc  {win} if the store is ahead of that rival on the mean and on at least two of the three seeds and every charter-C control's mean sits at least 0.15 below the store's (the store gate); otherwise \textsc  {comparable} if the mean paired difference is within one seed's spread (the sample standard deviation of the three per-seed differences); otherwise \textsc  {loss} if the store is behind. The first row is not like-for-like and carries no label: its rivals read a 636-dimensional observation, the store the 318-wide word design. The main-effects and observation rows are validation; the others are TEST. On words plus observation (A1) the rule reads \textsc  {win}, although that condition's pre-registered margin bar was not met. The last row is the CLU-REL-A10 configuration (colour-relational request coding) on seeds 0--2. No row is drawn as a margin bar. (b), (c)~Words plus observation, TEST, seeds 0--5, for A1 and for CLU-REL-A10: at each seed the store, the best of the six matched rivals on that seed, for CLU-REL-A10 the best rival handed the same relational request columns, the highest control, and the ceiling (the best arm fitted to the training data; in (c) including the relational rivals). Seeds 1 and 4 are hard: A1's ceiling on them falls below 0.6407, the largest gap in A1's per-seed ceilings, a split made by the ceiling and never by the store's own score. The relational coding raises the store on every seed. Handed the same columns, the best rival reaches 0.915, 0.869, 0.819, 0.921, 0.900 and 0.939 on seeds 0 to 5 against the store's 0.908, 0.894, 0.984, 0.927, 0.900 and 0.939: the gain comes from the request coding, not from the store. On seed 4 the random-atoms control also equals the store exactly (0.9004, on every held-out tuple, Figure~\ref {fig:maze-rel-tuples}); on seed 5 the best matched rival equals it. Every seed where a rival or a control reaches the store is marked. The six-seed panels carry no claim label.}}{44}{figure.12}\protected@file@percent }
\newlabel{fig:maze-wm}{{12}{44}{\textbf {CMAZE-T, one row per input condition, unseen $n$-way; (a)~3 seeds per row, (b), (c)~six seeds and two configurations.} (a)~Validity under the exact judge at each seed for the store (circles) and for the condition's best matched rival, the matched rival with the highest three-seed mean over every family and both training budgets; a tick marks each three-seed mean. One rule labels every row from its artefact: \textsc {win} if the store is ahead of that rival on the mean and on at least two of the three seeds and every charter-C control's mean sits at least 0.15 below the store's (the store gate); otherwise \textsc {comparable} if the mean paired difference is within one seed's spread (the sample standard deviation of the three per-seed differences); otherwise \textsc {loss} if the store is behind. The first row is not like-for-like and carries no label: its rivals read a 636-dimensional observation, the store the 318-wide word design. The main-effects and observation rows are validation; the others are TEST. On words plus observation (A1) the rule reads \textsc {win}, although that condition's pre-registered margin bar was not met. The last row is the CLU-REL-A10 configuration (colour-relational request coding) on seeds 0--2. No row is drawn as a margin bar. (b), (c)~Words plus observation, TEST, seeds 0--5, for A1 and for CLU-REL-A10: at each seed the store, the best of the six matched rivals on that seed, for CLU-REL-A10 the best rival handed the same relational request columns, the highest control, and the ceiling (the best arm fitted to the training data; in (c) including the relational rivals). Seeds 1 and 4 are hard: A1's ceiling on them falls below 0.6407, the largest gap in A1's per-seed ceilings, a split made by the ceiling and never by the store's own score. The relational coding raises the store on every seed. Handed the same columns, the best rival reaches 0.915, 0.869, 0.819, 0.921, 0.900 and 0.939 on seeds 0 to 5 against the store's 0.908, 0.894, 0.984, 0.927, 0.900 and 0.939: the gain comes from the request coding, not from the store. On seed 4 the random-atoms control also equals the store exactly (0.9004, on every held-out tuple, Figure~\ref {fig:maze-rel-tuples}); on seed 5 the best matched rival equals it. Every seed where a rival or a control reaches the store is marked. The six-seed panels carry no claim label}{figure.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces \textbf  {CMAZE-T, CLU-REL-A10, words plus observation, TEST: every held-out $n$-way tuple, seeds 0--5.} Each cell is the fraction of the tuple's rows judged valid by the exact judge, for the store, the seed's best matched rival, the best rival handed the relational request columns and the highest control; each row names its arm, and the count on the right is the number of tuples on which that arm's valid and total rows equal the store's. On seed 4 the random-atoms control and the best relational rival equal the store on 16 of 16 tuples; on seed 5 the best matched rival (a transformer at 80,000 steps) and the best relational rival do. Counts come from the zero-fit replay of the persisted objects, which are hash-identical to the objects that were scored.}}{45}{figure.13}\protected@file@percent }
\newlabel{fig:maze-rel-tuples}{{13}{45}{\textbf {CMAZE-T, CLU-REL-A10, words plus observation, TEST: every held-out $n$-way tuple, seeds 0--5.} Each cell is the fraction of the tuple's rows judged valid by the exact judge, for the store, the seed's best matched rival, the best rival handed the relational request columns and the highest control; each row names its arm, and the count on the right is the number of tuples on which that arm's valid and total rows equal the store's. On seed 4 the random-atoms control and the best relational rival equal the store on 16 of 16 tuples; on seed 5 the best matched rival (a transformer at 80,000 steps) and the best relational rival do. Counts come from the zero-fit replay of the persisted objects, which are hash-identical to the objects that were scored}{figure.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces \textbf  {Held-out CMAZE-T transitions, one per rule family, every arm (words plus observation, TEST).} For each family (the first TEST $n$-way row at seed 0; the \texttt  {rule\_a} family, which has almost no TEST $n$-way rows, from seed 2): $s_t$ with the action, the engine's $s_{t+1}$, and each arm's generated $s_{t+1}$ with the exact judge's mark: the store, the matched rivals at 8,000 and 80,000 training steps, the four charter-C controls and the two learned blind arms. Every panel is re-read from the condition's persisted objects, and the re-read reproduces every arm's scored TEST score on every seed. The store is the scored Config~A1 store: its TEST reads equal that run's on every seed (that run persisted no object to hash). The arms of Table~\ref {tab:cmazet}, whose rivals read the observation alone, were not persisted: {\color  {red}\textbf  {[PLACEHOLDER:}~w16 CMAZE-T per-arm generated $s_{t+1}$ (store, transformer, MLP, LSTM) with exact-judge marks, one success and one failure per arm: not buildable from persisted artefacts (a persistence re-run would be a new scored run); may remain undrawn, and if drawn may show the store failing where a rival succeeds\textbf  {]}}}}{46}{figure.14}\protected@file@percent }
\newlabel{fig:cmazet-families}{{14}{46}{\textbf {Held-out CMAZE-T transitions, one per rule family, every arm (words plus observation, TEST).} For each family (the first TEST $n$-way row at seed 0; the \texttt {rule\_a} family, which has almost no TEST $n$-way rows, from seed 2): $s_t$ with the action, the engine's $s_{t+1}$, and each arm's generated $s_{t+1}$ with the exact judge's mark: the store, the matched rivals at 8,000 and 80,000 training steps, the four charter-C controls and the two learned blind arms. Every panel is re-read from the condition's persisted objects, and the re-read reproduces every arm's scored TEST score on every seed. The store is the scored Config~A1 store: its TEST reads equal that run's on every seed (that run persisted no object to hash). The arms of Table~\ref {tab:cmazet}, whose rivals read the observation alone, were not persisted: \PLACEHOLDER {w16 CMAZE-T per-arm generated $s_{t+1}$ (store, transformer, MLP, LSTM) with exact-judge marks, one success and one failure per arm: not buildable from persisted artefacts (a persistence re-run would be a new scored run); may remain undrawn, and if drawn may show the store failing where a rival succeeds}}{figure.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces \textbf  {Each CMAZE-T arm succeeding and failing (words plus observation, TEST, seed 0).} For every arm, one held-out $n$-way transition on which its generated $s_{t+1}$ is exact and one on which it is not, each drawn uniformly with a fixed seed among the qualifying rows. The landscape-removed control and the blind-colour arm have no exact $n$-way row at seed 0 and show only a failure. Columns: $s_t$ with the action, the engine's $s_{t+1}$, and the arm's generated $s_{t+1}$ with the exact judge's mark.}}{47}{figure.15}\protected@file@percent }
\newlabel{fig:cmazet-per-arm}{{15}{47}{\textbf {Each CMAZE-T arm succeeding and failing (words plus observation, TEST, seed 0).} For every arm, one held-out $n$-way transition on which its generated $s_{t+1}$ is exact and one on which it is not, each drawn uniformly with a fixed seed among the qualifying rows. The landscape-removed control and the blind-colour arm have no exact $n$-way row at seed 0 and show only a failure. Columns: $s_t$ with the action, the engine's $s_{t+1}$, and the arm's generated $s_{t+1}$ with the exact judge's mark}{figure.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces \textbf  {Door-then-tint (\texttt  {interaction}) transitions, one per move direction present in the seed-0 hold-out, every arm (words plus observation, TEST).} Columns as in Figure~\ref {fig:cmazet-families}. For the arms of Table~\ref {tab:cmazet}: {\color  {red}\textbf  {[PLACEHOLDER:}~w16 CMAZE-T per-arm generated $s_{t+1}$ on the \texttt  {interaction} family, with exact-judge marks: not buildable from persisted artefacts; may remain undrawn, and if drawn may show every arm, the store included, failing the interaction\textbf  {]}}}}{47}{figure.16}\protected@file@percent }

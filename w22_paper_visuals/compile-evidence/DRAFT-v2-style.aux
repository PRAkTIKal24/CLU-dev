\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {Composition at $\ensuremath  {K^{\star }}=32$, Shapes3D value hold-out, TEST, $n=3$ seeds (0, 1, 2).} Distinct valid novel tuples per corner (ceiling 36 on row 3, 72 on row 4), per seed. Rivals are matched on read-path parameters (about 131k) and are the weaker of the paper's two rival sets (\S  \ref {sec:shapes-t7}, \emph  {Two rival sets}); the table is a floor, never a rival. ``Paired $\Delta $'' is the arm minus the comparator over all 109 corners (CI95 lower bound in the source); every comparator is beaten on 109/109 corners on every seed. The \texttt  {refit\_postfix} rows re-fit the two token families from scratch inside the scoring process after a dtype repair; seed 0 predates them and is a declared not-run for those two rows.}}{7}{table.1}\protected@file@percent }
\newlabel{tab:t7}{{1}{7}{\textbf {Composition at $\Kstar =32$, Shapes3D value hold-out, TEST, $n=3$ seeds (0, 1, 2).} Distinct valid novel tuples per corner (ceiling 36 on row 3, 72 on row 4), per seed. Rivals are matched on read-path parameters (about 131k) and are the weaker of the paper's two rival sets (\S \ref {sec:shapes-t7}, \emph {Two rival sets}); the table is a floor, never a rival. ``Paired $\Delta $'' is the arm minus the comparator over all 109 corners (CI95 lower bound in the source); every comparator is beaten on 109/109 corners on every seed. The \texttt {refit\_postfix} rows re-fit the two token families from scratch inside the scoring process after a dtype repair; seed 0 predates them and is a declared not-run for those two rows}{table.1}{}}

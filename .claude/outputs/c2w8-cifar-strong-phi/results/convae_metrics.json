  "protocol": {
    "scenario": "Class-IL (van de Ven & Tolias): new classes per task, task identity NOT given at test time",
    "stream": "Split-CIFAR10: 5 tasks \u00d7 2 classes, from scratch",
    "metrics": "GEM formulas (Lopez-Paz & Ranzato 2017): ACC, BWT, forgetting",
    "phi": "task1_only = PRIMARY (frozen after task 1); generic_frozen = declared upper bound that LEAKS future tasks; phi_dim=256 (\u226516 binding, PREREG_CL_PHI \u00a77)",
    "store": "designed Gaussian wells over \u03c6(x), payload = class label, MVC-0 controller (admission + placement + class-balanced eviction + scheduled decay). No exemplar is stored.",
    "memory": "matched at 200 items for the store, ER, iCaRL, GDumb and the kNN-in-\u03c6 launders; float counts reported too",
    "filing_rule": "CM-23(n) \u2014 best rehearsal-free is the claim; 'beats replay' is never claimed",
    "known_null": "EWC/SI/LwF collapse to \u2248chance in Class-IL by construction (van de Ven & Tolias 2019); their collapse is NOT a CLU win",

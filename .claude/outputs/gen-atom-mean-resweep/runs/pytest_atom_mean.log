    def test_raising_n_val_COSTS_fit_rows_arithmetically():
        """⭐ ``n_fit`` is deliberately NOT a flag — and this is why it does not need to be.
    
        ``stratified_fit_val`` cuts ``val`` FIRST and gives ``fit`` the remainder, so a
        larger ``n_val`` lowers the realised ``n_fit`` by exactly the rows it took.  ⛔ The
        trade-off is arithmetic and unavoidable; a sweep report that does not price it is
        reporting identification bought by hobbling the comparators.
        """
        from chlu.data.gen_rowsplit import stratified_fit_val
    
        rng = np.random.default_rng(3)
        n_pool = 2048
        pool = np.arange(n_pool, dtype=np.int64)
        labels = np.stack([rng.integers(0, c, n_pool) for c in (10, 10, 10, 8, 4, 15)], 1)
        n_fit_asked = 1_984  # the 32,256-analogue: pool - the small val cut
    
        small_fit, small_val, _ = stratified_fit_val(pool, labels, n_fit_asked, 64, 0)
        big_fit, big_val, _ = stratified_fit_val(pool, labels, n_fit_asked, 512, 0)
    

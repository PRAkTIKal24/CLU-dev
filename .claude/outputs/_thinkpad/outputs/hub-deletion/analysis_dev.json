      "clu_before": 0.6003011067708333,
      "gap": -0.12910970052083337,
      "knn_before": 0.7294108072916666,
      "why": "if damage is roughly proportional to level, the arm that starts LOWER loses fewer raw accuracy points, so Delta reads positive from the level gap alone. This favours the CLU."
    },
    "rebuild_churn_favours_knn_proto": {
      "measured_by": "the size-matched placebo delta per deletion",
      "why": "the CLU's 'after' is a fresh 1200-step optimisation on a re-derived channel partition; knn_proto has NO optimiser and its table is a closed-form mean. The uncorrected primary therefore charges the CLU for rebuild churn as if it were deletion damage. This favours knn_proto."
    },
    "resolution": "\u26d4 Neither bias is argued about: the churn term IS `collateral_churn_corrected` and the level gap IS the numbers above. Both are reported beside the primary, and `retention` is the estimand in which the level gap cancels."
  },
